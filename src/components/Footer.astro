---
import { Image } from "astro:assets";
import GCashQR from "../files/GCashQR.webp";
import Rickroll from "../files/haha.gif";
---

<footer>
	<p>Created by <span class="contributor_names">Ron</span></p>
	<!-- <p>Maintained by <span class="contributor_names">Angel</span></p> -->
	<p>
		Feeling curious? ➡ <span id="show-QR" class="select-none">Click me!</span>
	</p>

	<div class="donate-info">
		<!-- <img id="GcashQR" src="/GCashQR.webp" width="300" height="300" /> -->
		<!-- <Image src={GCashQR} alt="GcashQR" width="300" height="300" /> -->
		<img src={Rickroll.src} alt="Rickroll" width="300" height="300" />
		<!-- <p>I really appreciate it.</p>
		<p>Thank you so much! 💖</p> -->
		<p>Never gonna give you up</p>
		<p>Never gonna let you down</p>
	</div>
</footer>

<style>
	footer {
		text-align: center;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		padding: 1rem;
		background: rgba(53, 53, 53, 0.822);
		color: white;
		width: 100%;
	}
	#show-QR {
		cursor: pointer;
		color: rgb(172, 179, 255);
	}

	.contributor_names {
		font-weight: bold;
		color: rgb(94 205 233);
	}
	.donate-info {
		flex-direction: column;
		position: fixed;
		right: 1rem;
		bottom: 1rem;
		color: black;
		font-size: large;
		font-weight: 600;
		gap: 0.5rem;
		border: 1.5px solid black;
		padding: 0.5rem;
		border-radius: 0.5rem;
		background: lightblue;
	}

	img {
		border-radius: 0.3rem;
		border: 1px solid rgba(128, 128, 128, 0.432);
	}
</style>

<script>
	const showQR = document.querySelector("#show-QR")!;
	const donateInfo = document.querySelector(".donate-info")!;

	// Toggle QR visibility
	showQR.addEventListener("click", () => {
		if ((donateInfo as HTMLElement).style.display === "none") {
			(donateInfo as HTMLElement).style.display = "flex";
		} else {
			(donateInfo as HTMLElement).style.display = "none";
		}
	});

	// Initialize first state (hidden)
	(donateInfo as HTMLElement).style.display = "none";

	// Hide QR when clicked
	(donateInfo as HTMLElement).addEventListener("click", () => {
		(donateInfo as HTMLElement).style.display = "none";
	});
</script>
